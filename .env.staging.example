# =============================================================================
# NeerAI Backend - Staging Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO .env OR SET THESE ENVIRONMENT VARIABLES IN YOUR STAGING RUNTIME.
# DO NOT COMMIT REAL PRODUCTION OR STAGING SECRETS TO SOURCE CONTROL.
# =============================================================================

# --- Environment & Security ---
APP_ENV=staging
CORS_ORIGINS=https://staging.neerai.internal,exp://*
LOG_LEVEL=INFO
ENABLE_DOCS=true

# --- Database & Persistence ---
# Path to the persistent SQLite database file inside the container or host
DATABASE_PATH=app/data/neerai_staging.db
DATABASE_BUSY_TIMEOUT_MS=10000
CACHE_RETENTION_HOURS=72
ALERT_HISTORY_RETENTION_DAYS=30
MAX_TURNS_PER_CONVERSATION=15
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Marine & Meteorological APIs ---
# Open-Meteo & ECMWF (No key required for standard tier / commercial key if provisioned)
WEATHER_API_KEY=

# Indian National Centre for Ocean Information Services (INCOIS)
# Institutional credentials for PFZ and OSF services
INCOIS_API_KEY=

# India Meteorological Department (IMD)
# Institutional key for cyclone and storm warning bulletins
IMD_API_KEY=

# MOSDAC (ISRO Meteorological and Oceanographic Satellite Data Archival Centre)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# NASA Earthdata CMR (Earth Science Data Systems)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# --- Resiliency, Fallbacks & Data Integrity ---
CONNECTOR_TIMEOUT_SECONDS=6.0
CONNECTOR_MAX_RETRIES=2
# CRITICAL: Must be false in staging. Zero-fabrication policy prohibits simulated marine data.
ENABLE_SIMULATION_FALLBACK=false
REQUIRE_REAL_DATA=true

# --- GIS & Maps ---
MAPBOX_ACCESS_TOKEN=

# --- AI, LLM & Multilingual Voice Services ---
OPENAI_API_KEY=
LLM_API_KEY=
SARVAM_API_KEY=

# --- Notifications & Push Delivery ---
FCM_SERVER_KEY=
EXPO_ACCESS_TOKEN=
NOTIFICATION_SANDBOX_MODE=true

# --- Configurable Maritime Hazard Thresholds ---
WIND_SPEED_WARNING_KMH=40.0
WIND_GUST_WARNING_KMH=55.0
WAVE_HEIGHT_WARNING_M=2.5
BAROMETRIC_PRESSURE_DROP_HPA=998.0
ALERT_DEDUPLICATION_WINDOW_MINUTES=60
