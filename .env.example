# NeerAI Backend Environment Configuration Template
# Copy this file to .env and fill in valid credentials where available.

# AI & Language Services
OPENAI_API_KEY=
LLM_API_KEY=
SARVAM_API_KEY=

# GIS & Geospatial Services
MAPBOX_ACCESS_TOKEN=

# Indian Marine & Meteorological Agencies
IMD_API_KEY=
INCOIS_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Global Oceanographic Services
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Push Notifications & Delivery
FCM_SERVER_KEY=
EXPO_ACCESS_TOKEN=
NOTIFICATION_SANDBOX_MODE=true

# Resiliency, Retries & Fallback Controls
CONNECTOR_TIMEOUT_SECONDS=6.0
CONNECTOR_MAX_RETRIES=2
ENABLE_SIMULATION_FALLBACK=false

# Marine Hazard Thresholds
WIND_SPEED_WARNING_KMH=40.0
WIND_GUST_WARNING_KMH=55.0
WAVE_HEIGHT_WARNING_M=2.5
BAROMETRIC_PRESSURE_DROP_HPA=998.0
ALERT_DEDUPLICATION_WINDOW_MINUTES=60

# Environment & Security
APP_ENV=development
CORS_ORIGINS=*
